{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "nix-cloudflare",
      "include-v-in-tag": true,
      "include-v-in-release-name": true,
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "extra-files": [
        "README.md",
        "deployment/terraform/README.md",
        "deployment/terraform/variables.tf",
        {
          "type": "toml",
          "path": "crates/nix-cloudflare-api/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='nix-cloudflare-api')].version"
        },
        {
          "type": "toml",
          "path": "crates/nix-cloudflare-sdk/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='nix-cloudflare-sdk')].version"
        }
      ]
    }
  }
}
